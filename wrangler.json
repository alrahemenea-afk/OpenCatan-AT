{
  "$schema": "https://json.schemastore.org/wrangler.json",
  "name": "open-catan",
  "main": "party/worker.ts",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/parties/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "Game", "class_name": "GameServer" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameServer"] }]
}